f# MySQL connection
DB_HOST=localhost
DB_PORT=10000
DB_USER=root
DB_PASSWORD=
DB_NAME=agrovite

# Admin login password — checked by POST /api/admin/login
ADMIN_PASSWORD=changeme

# Email OTP verification — SMTP credentials for sending the 6-digit
# codes used by /api/login, /api/register, and /api/resend-otp.
# These same credentials are also used to email every buyer whenever
# a new produce listing is created.
# Leave these blank to test locally: OTP codes and notification
# emails will just be printed to this server's terminal instead of
# sent, so the whole flow still works before you set up a real
# email provider.
#
# Example using Gmail (you need an "App Password", not your normal
# Gmail password — generate one at myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your16charapppassword
#   SMTP_FROM=youraddress@gmail.com
#
# Any other SMTP provider (SendGrid, Mailgun, your host's email, etc.)
# works the same way — just use the host/port/user/pass they give you.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server port
PORT=4000
